# ─────────────────────────────────────────────────────────
# SortHat — Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file to version control.

# Formspree form endpoint for order submissions
# Get yours at https://formspree.io/
# Format: https://formspree.io/f/XXXXXXXX
FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID_HERE

# If you switch to a backend API for form handling in the future,
# add those variables below:
# API_BASE_URL=https://your-api.com
# API_KEY=your_api_key_here
